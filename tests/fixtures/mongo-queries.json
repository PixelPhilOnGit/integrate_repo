      "op": "find",
      "filter": {
        "createdAt": {
          "$gte": "2026-01-01T00:00:00Z"
        }
      }
    },
    {
      "query": "db.users.find({ name: /^张/i })",
      "collection": "users",
      "op": "find",
      "filter": {
        "name": "/^张/i"
      }
    },
    {
      "query": "db.users.find({ tags: [\"a\", \"b\"], ok: true, gone: null, n: 1.5 })",
      "collection": "users",
      "op": "find",
      "filter": {
        "tags": [
          "a",
          "b"
        ],
        "ok": true,
        "gone": null,
        "n": 1.5
      }
    },
    {
      "query": "db[\"my-col\"].find({})",
      "collection": "my-col",
      "op": "find"
    },
    {
      "query": "db.getCollection(\"logs-2026.10\").find({ level: \"error\" })",
      "collection": "logs-2026.10",
      "op": "find",
      "filter": {
        "level": "error"
      }
    },
    {
      "query": "db.users.countDocuments({ city: \"北京\" })",
      "collection": "users",
      "op": "count",
      "filter": {
        "city": "北京"
      }
    },
    {
      "query": "db.users.countDocuments({}, { limit: 5 })",
      "collection": "users",
      "op": "count",
      "limit": 5
    },
    {
      "query": "db.users.find({}).count()",
      "collection": "users",
      "op": "count"
    },
    {
      "query": "db.users.distinct(\"city\")",
      "collection": "users",
      "op": "distinct",
