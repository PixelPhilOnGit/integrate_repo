      "query": "db.users.findOne({ name: '张三' })",
      "collection": "users",
      "op": "findOne",
      "filter": {
        "name": "张三"
      }
    },
    {
      "query": "db.users.find({ name: \"张三\" }); // 分号 + 注释",
