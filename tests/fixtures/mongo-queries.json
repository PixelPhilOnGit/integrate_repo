      "op": "distinct",
      "field": "city",
      "filter": {
        "age": {
          "$gte": 18
        }
      }
    },
    {
      "query": "db.users.aggregate([{ $match: { age: { $gte: 18 } } }, { $group: { _id: \"$city\", n: { $sum: 1 } } }])",
      "collection": "users",
      "op": "aggregate",
      "pipeline": [
        {
          "$match": {
            "age": {
              "$gte": 18
            }
          }
        },
        {
          "$group": {
            "_id": "$city",
            "n": {
              "$sum": 1
            }
          }
        }
      ]
    },
    {
      "query": "db.users.insertOne({ name: \"张三\", age: 30 })",
      "collection": "users",
      "op": "insertOne",
      "document": {
        "name": "张三",
        "age": 30
      }
    },
    {
      "query": "db.users.insertMany([{ name: \"a\" }, { name: \"b\" }])",
      "collection": "users",
      "op": "insertMany",
      "documents": [
        {
          "name": "a"
        },
        {
          "name": "b"
        }
      ]
    },
    {
      "query": "db.users.updateMany({ city: \"北京\" }, { $set: { vip: true } })",
      "collection": "users",
      "op": "update",
      "filter": {
        "city": "北京"
      },
      "update": {
        "$set": {
          "vip": true
        }
      },
      "many": true
    },
    {
      "query": "db.users.updateOne({ name: \"张三\" }, { $set: { age: 31 } }, { upsert: true })",
      "collection": "users",
      "op": "update",
      "filter": {
        "name": "张三"
      },
      "update": {
        "$set": {
          "age": 31
        }
      },
      "many": false,
      "upsert": true
    },
    {
      "query": "db.users.deleteMany({ vip: true })",
      "collection": "users",
      "op": "delete",
      "filter": {
        "vip": true
      },
      "many": true
    },
    {
      "query": "db.users.findOneAndUpdate({ name: \"张三\" }, { $inc: { age: 1 } }, { returnDocument: \"after\" })",
      "collection": "users",
      "op": "findOneAndUpdate",
      "filter": {
        "name": "张三"
      },
      "update": {
        "$inc": {
          "age": 1
        }
      },
      "returnAfter": true
    },
    {
      "query": "db.users.createIndex({ email: 1 }, { unique: true })",
      "collection": "users",
      "op": "createIndex",
      "keys": {
        "email": 1
      },
      "unique": true
    },
    {
      "query": "db.users.getIndexes()",
      "collection": "users",
      "op": "getIndexes"
    },
    {
      "query": "db.users.dropIndex(\"email_1\")",
      "collection": "users",
      "op": "dropIndex",
      "name": "email_1"
    },
    {
      "query": "db.users.drop()",
      "collection": "users",
      "op": "drop"
    },
    {
      "query": "db.dropDatabase()",
      "op": "dropDatabase"
    },
    {
      "query": "db.createCollection(\"审计日志\")",
