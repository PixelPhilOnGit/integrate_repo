      "op": "find",
      "filter": {
        "name": "张三"
      }
    },
    {
      "query": "db.users.find({ _id: ObjectId(\"507f1f77bcf86cd799439011\") })",
      "collection": "users",
      "op": "find",
      "filter": {
        "_id": "507f1f77bcf86cd799439011"
      }
    },
    {
      "query": "db.users.find({ createdAt: { $gte: ISODate(\"2026-01-01T00:00:00Z\") } })",
